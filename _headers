# Netlify headers for The Ryder McCoy Band site
# Page HTML must revalidate so new releases and edits appear immediately.

/
  Cache-Control: public, max-age=0, must-revalidate

/warning/
  Cache-Control: public, max-age=0, must-revalidate

/glass-rose/
  Cache-Control: public, max-age=0, must-revalidate

/fall/
  Cache-Control: public, max-age=0, must-revalidate

/woods/
  Cache-Control: public, max-age=0, must-revalidate

/wall/
  Cache-Control: public, max-age=0, must-revalidate

/dirt-road/
  Cache-Control: public, max-age=0, must-revalidate

/slapout-run/
  Cache-Control: public, max-age=0, must-revalidate

/*.jpg
  Cache-Control: public, max-age=3600, must-revalidate

/*.jpeg
  Cache-Control: public, max-age=3600, must-revalidate

/*.png
  Cache-Control: public, max-age=3600, must-revalidate

/*.webp
  Cache-Control: public, max-age=3600, must-revalidate

/*.mp4
  Cache-Control: public, max-age=3600, must-revalidate

/*.mp3
  Cache-Control: public, max-age=3600, must-revalidate

/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
